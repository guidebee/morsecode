<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <application
        android:name=".MorseApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="au.com.guidebee.morsetoolkit.ui.HomeActivity"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".flappybird.FlappyBirdGameActivity"
            android:label="FlappyBird"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation">
        </activity>

        <activity
            android:name=".battlecity.BattleCityGameActivity"
            android:label="BattleCity"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation">
        </activity>

        <activity
            android:name=".mario.MarioGameActivity"
            android:label="Ampere's Run"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation">
        </activity>

        <!--
          gameengine upgrade regression fixtures (see docs/GAMEENGINE_UPGRADE_PLAN.md
          section 5.4/5.5) — the official GuidebeeGameEngine Box2D and Raindrop tutorial
          demos, imported in-app as extra menu entries so they exercise engine surface
          area (Box2D bodies/joints/sensors, tiled maps, the MIDP-style API) that none
          of the 3 shipped games use directly.
        -->
        <activity
            android:name="com.guidebee.game.tutorial.box2d.StagePickerActivity"
            android:label="Box2D Demo"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />
        <activity
            android:name="com.guidebee.game.tutorial.box2d.Box2DGameActivity"
            android:label="Box2D Demo"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation"
            android:exported="false" />

        <activity
            android:name="com.mapdigit.game.tutorial.LessonPickerActivity"
            android:label="Raindrop Demo"
            android:theme="@style/AppTheme.NoActionBar"
            android:exported="false" />
        <activity
            android:name="com.mapdigit.game.tutorial.basics.HelloWorldActivity"
            android:label="Raindrop: Basics"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation"
            android:exported="false" />
        <activity
            android:name="com.mapdigit.game.tutorial.coords.CoordinateGameActivity"
            android:label="Raindrop: Coordinates"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation"
            android:exported="false" />
        <activity
            android:name="com.mapdigit.game.tutorial.drop.DropGameActivity"
            android:label="Raindrop: Drop"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation"
            android:exported="false" />
        <activity
            android:name="com.mapdigit.game.tutorial.microedition.DropGameActivity"
            android:label="Raindrop: Microedition"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation"
            android:exported="false" />
    </application>

</manifest>
